# Supabase Auth, solo para login/sesión (nunca para leer datos). Es seguro que estas dos
# sean públicas: van al navegador tal cual.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# URL de la API (apps/api). Nunca NEXT_PUBLIC_: el navegador nunca la llama
# directo, solo el servidor de Next (Server Components y Server Actions).
API_URL=http://localhost:3001
