# Supabase Auth, solo para login/sesión (nunca para leer datos). Es seguro que estas sean
# públicas: van al navegador tal cual. El nombre del bucket tampoco es secreto (sale en
# cualquier URL firmada); el navegador lo necesita para subir un archivo con esa URL
# directo a Storage (docs/guides/security.md #7). Debe ser el mismo nombre que
# SUPABASE_STORAGE_BUCKET en apps/api/.env.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=kairo-files

# URL de la API (apps/api). Nunca NEXT_PUBLIC_: el navegador nunca la llama
# directo, solo el servidor de Next (Server Components y Server Actions).
API_URL=http://localhost:3001
