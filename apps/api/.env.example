# Rol kairo_api, a través del pooler de Supabase en modo transacción (puerto 6543).
# La usa la API en tiempo de ejecución (DbModule). Ver docs/guides/security.md.
DATABASE_URL=postgresql://kairo_api.<project-ref>:<password>@<pooler-host>:6543/postgres

# Rol kairo_api, pooler en modo sesión (puerto 5432). Solo la usa drizzle-kit para generar y correr
# migraciones. La conexión directa (db.<project-ref>.supabase.co) es IPv6-only; si tu red sí tiene
# salida IPv6 puedes usarla en su lugar.
DIRECT_URL=postgresql://kairo_api.<project-ref>:<password>@<pooler-host>:5432/postgres

# Supabase Auth: invitar usuarios, verificar tokens. SUPABASE_SECRET_KEY nunca se expone al front.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<...>

# Bucket privado de Storage (docs/guides/security.md #7). Crearlo una sola vez con:
#   pnpm run storage:create-bucket
SUPABASE_STORAGE_BUCKET=kairo-files
