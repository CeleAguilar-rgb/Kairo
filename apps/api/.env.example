# Rol kairo_api, a través del pooler de Supabase en modo transacción (puerto 6543).
# La usa la API en tiempo de ejecución (DbModule). Ver docs/guides/security.md.
DATABASE_URL=postgresql://kairo_api.<project-ref>:<password>@<pooler-host>:6543/postgres

# Rol kairo_api, conexión directa (puerto 5432). Solo la usa drizzle-kit para generar y correr migraciones.
DIRECT_URL=postgresql://kairo_api:<password>@db.<project-ref>.supabase.co:5432/postgres
